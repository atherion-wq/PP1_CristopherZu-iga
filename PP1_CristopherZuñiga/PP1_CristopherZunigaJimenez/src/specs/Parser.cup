package compiler;

import java_cup.runtime.Symbol;
import java.util.List;

parser code {:
    public java.util.List<ErrorCompilador> errores = new java.util.ArrayList<>();

        private String nombreToken(int id) {
            for (java.lang.reflect.Field f : sym.class.getFields()) {
                try {
                    if (f.getType() == int.class && f.getInt(null) == id) {
                        return f.getName();
                    }
                } catch (IllegalAccessException e) { }
            }
            return "?" + id;
        }

        private String esperados() {
            java.util.List<String> nombres = new java.util.ArrayList<>();
            for (int id : expected_token_ids()) {
                nombres.add(nombreToken(id));
            }
            return String.join(", ", nombres);
        }

        @Override
        public void syntax_error(Symbol cur) {
            boolean eof = (cur.sym == sym.EOF);
            String desc = eof ? "Fin de archivo inesperado" : "Token inesperado";

            String esp = esperados();
            if (!esp.isEmpty()) {
                desc += ". Se esperaba: " + esp;
            }

            errores.add(new ErrorCompilador(
                "Sintáctico",
                eof ? "EOF" : String.valueOf(cur.value),
                desc,
                cur.left,
                cur.right));
        }

    @Override
    public void unrecovered_syntax_error(Symbol cur) throws Exception {
        errores.add(new ErrorCompilador(
            "Sintáctico",
            String.valueOf(cur.value),
            "No fue posible recuperarse del error",
            cur.left,
            cur.right));
    }
:}


