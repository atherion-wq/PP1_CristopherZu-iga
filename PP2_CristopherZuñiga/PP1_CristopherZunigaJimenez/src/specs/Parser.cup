literalString ::=
    LITERAL_STRING:lexema
    {:
        RESULT = new Nodo(Nodo.Clase.LITERAL_CADENA,
                          lexema, lexemaleft, lexemaright, List.of());
    :}
;

/* ------------  Errores, estados de sincronizacion  ---------------- */


sentencia ::=
    error:falla
    DELIMITADOR
    {:
        RESULT = nodo(Nodo.Clase.ERROR, "", fallaleft, fallaright);
    :}
;


declaracionVarGlobal ::=
    error:falla
    DELIMITADOR
    {:
        RESULT = nodo(Nodo.Clase.ERROR, "", fallaleft, fallaright);
    :}
;


condicion ::=
    error:falla
    {:
        RESULT = nodo(Nodo.Clase.ERROR, "", fallaleft, fallaright);
    :}
;


parametro ::=
    error:falla
    {:
        RESULT = nodo(Nodo.Clase.ERROR, "", fallaleft, fallaright);
    :}
;


argumento ::=
    error:falla
    {:
        RESULT = nodo(Nodo.Clase.ERROR, "", fallaleft, fallaright);
    :}
;


inicializacionFor ::=
    error:falla
    {:
        RESULT = nodo(Nodo.Clase.ERROR, "", fallaleft, fallaright);
    :}
;
actualizacionFor ::=
    error:falla
    {:
        RESULT = nodo(Nodo.Clase.ERROR, "", fallaleft, fallaright);
    :}
;


obtenerDatoArreglo ::=
    IDENTIFICADOR:identificador CORCHETE_ABRE error CORCHETE_CIERRA
    {:
        RESULT = nodo(Nodo.Clase.ERROR, identificador, identificadorleft, identificadorright);
    :}
;