expresionModuloNoIdent ::=
    expresionModulo:expresionModulo
    operadorModulo:operadorModulo
    expresionMultiplicativa:expresionMultiplicativa
    {:
        RESULT = binaria(operadorModulo, expresionModulo, expresionMultiplicativa);
    :}
;


operadorModulo ::=
    MODULO:operador
    {:
        RESULT = new Symbol(sym.MODULO, operadorleft, operadorright, operador);
