    expresionNumerica:expresionNumerica
    CORCHETE_CIERRA
    continuacionRelacionNumerica:continuacionRelacionNumerica
    {:
        RESULT = binaria(continuacionRelacionNumerica.operador, expresionNumerica, continuacionRelacionNumerica.derecha);
    :}
;

continuacionRelacionNumerica ::=
    operadorOrden:operadorOrden
    CORCHETE_ABRE
    expresionNumerica:expresionNumerica
    CORCHETE_CIERRA
    {:
        RESULT = new Parser.Comparacion(operadorOrden, expresionNumerica);
    :}
;

continuacionRelacionNumerica ::=
    operadorComparacion:operadorComparacion
    CORCHETE_ABRE
    operandoIgualdad:operandoIgualdad
    CORCHETE_CIERRA
    {:
        RESULT = new Parser.Comparacion(operadorComparacion, operandoIgualdad);
    :}
;


